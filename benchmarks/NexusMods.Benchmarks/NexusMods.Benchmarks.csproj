<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!--
            This is a BenchmarkDotNet runner, not a test module. It references the test
            projects for their fixtures, which makes the testing platform treat it as one:
            `dotnet test` on the solution launches it, it runs no tests and the run exits 1.
        -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>


    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets/**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\NexusMods.DataModel\NexusMods.DataModel.csproj" />
      <ProjectReference Include="..\..\tests\NexusMods.DataModel.Tests\NexusMods.DataModel.Tests.csproj" />
    </ItemGroup>
</Project>
