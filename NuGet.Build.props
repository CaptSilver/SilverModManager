<Project>
    <PropertyGroup>
        <!-- Overwrites IsPackable from global Directory.Build.props -->
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>David Goree</Authors>

        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <PackageProjectUrl>https://github.com/CaptSilver/SilverModManager</PackageProjectUrl>
        <RepositoryUrl>https://github.com/CaptSilver/SilverModManager.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- https://github.com/dotnet/sourcelink/tree/main/docs#publishrepositoryurl -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>
</Project>
