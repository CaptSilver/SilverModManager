<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!--
            xunit.v3 test projects are executables. Helper libraries that only
            share test code (Games.TestFramework, StandardGameLocators.TestHelpers) set
            <OutputType>Library</OutputType> and are left out of everything below that is
            conditioned on OutputType.
        -->
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <PropertyGroup>
        <!--
            Extra command line arguments for the test executables, set from the outside:
            dotnet test, solution mode, with -p:XunitArgs=...
        -->
        <TestingPlatformCommandLineArguments>$(XunitArgs)</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="NSubstitute.Analyzers.CSharp"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AutoFixture" />
        <PackageReference Include="AutoFixture.Xunit3" />
        <!-- NexusMods.Paths.TestingHelpers pulls in AutoFixture.Xunit2 (and with it xunit v2 attributes), which clash with xunit.v3 -->
        <PackageReference Include="AutoFixture.Xunit2" ExcludeAssets="all" />
        <PackageReference Include="xunit.extensibility.core" ExcludeAssets="all" />
        <PackageReference Include="xunit.abstractions" ExcludeAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="FluentAssertions.OneOf" />
        <PackageReference Include="FluentAssertions.Analyzers" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Xunit.DependencyInjection" />
        <PackageReference Include="Xunit.DependencyInjection.Logging" />
    </ItemGroup>

    <!--
        Runner and reporters, only for projects that produce a test executable. Console helpers that
        tests spawn (silvermod-testhost) set IsTestHostHelper: the runner generates an entry point
        that would clash with their own Main.
    -->
    <ItemGroup Condition="'$(OutputType)' == 'Exe' And '$(IsTestHostHelper)' != 'true'">
        <PackageReference Include="xunit.v3.mtp-v2" />
        <PackageReference Include="GitHubActionsTestLogger" />
    </ItemGroup>

    <!-- Helper libraries only need the xunit types, not the runner -->
    <ItemGroup Condition="'$(OutputType)' != 'Exe'">
        <PackageReference Include="xunit.v3.extensibility.core" />
        <PackageReference Include="xunit.v3.assert" />
    </ItemGroup>
</Project>
