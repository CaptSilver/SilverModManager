<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\SmmNativeRid.props" />

    <PropertyGroup>
        <!-- Without this the SDK treats a plain library as RID-agnostic and builds it without the app's -r, so SmmNativeRid would fall back to the build machine. -->
        <IsRidAgnostic>false</IsRidAgnostic>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SilverModManager.Sdk\SilverModManager.Sdk.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Octopus.Octodiff" />
        <PackageReference Include="BCnEncoder.Net" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    </ItemGroup>

    <ItemGroup>
        <!-- Built from extern/texenc by scripts/build-texenc.sh. -->
        <None Include="runtimes\$(SmmNativeRid)\native\libsmmtexenc.so">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath>runtimes/$(SmmNativeRid)/native</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SilverModManager.Wabbajack.Transforms.Tests" />
        <InternalsVisibleTo Include="SilverModManager.Wabbajack.Tests" />
        <InternalsVisibleTo Include="SilverModManager.Benchmarks" />
    </ItemGroup>
</Project>
