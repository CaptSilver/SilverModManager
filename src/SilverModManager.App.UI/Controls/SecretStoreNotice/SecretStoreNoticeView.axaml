<reactiveUi:ReactiveUserControl
    d:DesignHeight="48"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="NexusMods.App.UI.Controls.SecretStoreNotice.SecretStoreNoticeView"
    x:TypeArguments="secretStoreNotice:ISecretStoreNoticeViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveUi="http://reactiveui.net"
    xmlns:secretStoreNotice="clr-namespace:NexusMods.App.UI.Controls.SecretStoreNotice"
    xmlns:controls="clr-namespace:NexusMods.App.UI.Controls"
    xmlns:alerts="clr-namespace:NexusMods.App.UI.Controls.Alerts">

    <Design.DataContext>
        <secretStoreNotice:SecretStoreNoticeDesignViewModel />
    </Design.DataContext>

    <Border Padding="12,8">
        <alerts:Alert x:Name="NoticeAlert"
                      Severity="Warning"
                      ShowDismiss="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:StandardButton x:Name="UnlockButton"
                                         Type="Secondary"
                                         Fill="None"
                                         Text="Unlock" />
                <controls:StandardButton x:Name="DismissButton"
                                         Type="Tertiary"
                                         Fill="None"
                                         Text="Dismiss" />
            </StackPanel>
        </alerts:Alert>
    </Border>

</reactiveUi:ReactiveUserControl>
