<reactiveUi:ReactiveWindow
    Icon="/Assets/silver-fox.png"
    Title="SilverModManager"
    d:DesignHeight="450"
    d:DesignWidth="800"
    MinHeight="360"
    MinWidth="360"
    mc:Ignorable="d"
    x:Class="SilverModManager.App.UI.Windows.MainWindow"
    x:TypeArguments="windows:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveUi="http://reactiveui.net"
    xmlns:windows="clr-namespace:SilverModManager.App.UI.Windows"
    xmlns:workspace="clr-namespace:SilverModManager.App.UI.WorkspaceSystem"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SurfaceWindowBrush}">

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <!--  ReSharper disable once Xaml.ConstructorWarning  -->
        <windows:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="72, 232, *" RowDefinitions="Auto, *, Auto, 48">

        <Border x:Name="OverlayBorder"
                Background="{StaticResource BrandTranslucentDark800Brush}"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="1">

            <reactiveUi:ViewModelViewHost x:Name="OverlayViewHost"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ClipToBounds="False"/>
        </Border>

        <Border x:Name="DropOverlay"
                Background="{StaticResource BrandTranslucentDark800Brush}"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                IsVisible="False"
                ZIndex="2">
            <TextBlock x:Name="DropOverlayText"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Transparent so presses on empty top bar space hit this border and can drag the window -->
        <Border x:Name="TopBarBorder"
                Background="Transparent"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Grid.Row="0">
            <reactiveUi:ViewModelViewHost x:Name="TopBarViewModelHost" />
        </Border>

        <Border x:Name="SpineBorder"
                Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="4">
            <reactiveUi:ViewModelViewHost x:Name="SpineViewModelHost" />
        </Border>

        <!-- The window base is the darkest surface; the left menu and the page sit on it as raised panels, with gutters of the base between them -->
        <Border x:Name="LeftMenuBorder"
                Background="{StaticResource SurfaceLowBrush}"
                ClipToBounds="True"
                CornerRadius="8"
                Grid.Column="1"
                Grid.Row="1"
                Grid.RowSpan="3"
                Margin="6,0,0,6">
            <reactiveUi:ViewModelViewHost x:Name="LeftMenuViewModelHost" />
        </Border>

        <Border x:Name="WorkspacesBorder"
                Grid.Column="2"
                Grid.Row="1"
                Background="{StaticResource SurfaceLowBrush}"
                ClipToBounds="True"
                CornerRadius="8"
                Margin="6,0,6,6">

            <workspace:WorkspaceView x:Name="WorkspaceView" />
        </Border>

        <!-- The bottom strips sit under the page only; the spine and left menu run to the bottom of the window -->
        <reactiveUi:ViewModelViewHost x:Name="SecretStoreNotice"
                                      Grid.Column="2"
                                      Grid.Row="2" />

        <reactiveUi:ViewModelViewHost x:Name="DevelopmentBuildBanner"
                                      Grid.Column="2"
                                      Grid.Row="3" />
    </Grid>

</reactiveUi:ReactiveWindow>
