<reactive:ReactiveUserControl
    x:TypeArguments="loadoutPage:ICollectionLoadoutViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactive="http://reactiveui.net"
    xmlns:loadoutPage="clr-namespace:SilverModManager.App.UI.Pages.LoadoutPage"
    xmlns:icons="clr-namespace:SilverModManager.UI.Sdk.Icons;assembly=SilverModManager.UI.Sdk"
    xmlns:controls="clr-namespace:SilverModManager.App.UI.Controls"
    xmlns:search="clr-namespace:SilverModManager.App.UI.Controls.Search"
    xmlns:navigation="clr-namespace:SilverModManager.App.UI.Controls.Navigation"
    xmlns:collectionDownload="clr-namespace:SilverModManager.App.UI.Pages.CollectionDownload"
    xmlns:resources="clr-namespace:SilverModManager.App.UI.Resources"
    mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="450"
    x:Class="SilverModManager.App.UI.Pages.LoadoutPage.CollectionLoadoutView">

    <Design.DataContext>
        <loadoutPage:CollectionLoadoutDesignViewModel />
    </Design.DataContext>

    <reactive:ReactiveUserControl.Resources>
        <!-- statusbar at top, tree data grid fill the remaining space -->
        <DockPanel x:Key="TabItemContent">
            <!-- statusbar -->
            <controls:Statusbar Classes="Primary" DockPanel.Dock="Top">

                <!-- filters the mods by name or by a file they deploy -->
                <search:SearchControl x:Name="SearchControl" ButtonSize="Toolbar" />

                <!-- "Open on Nexus Mods", "Open readme" -->
                <!-- text, icon and command are bound rather than set in code, so the button's first layout already has them -->
                <controls:StandardButton x:Name="LinkButton"
                                         Text="{ReflectionBinding Link.Text}"
                                         LeftIcon="{ReflectionBinding Link.Icon}"
                                         Command="{ReflectionBinding Link.Command}"
                                         ShowIcon="Left"
                                         Size="Toolbar"
                                         Type="Tertiary" />
                <!-- where the collection comes from -->
                <StackPanel x:Name="BadgeStack"
                            Orientation="Horizontal"
                            Spacing="4">
                    <icons:UnifiedIcon x:Name="BadgeIcon" Size="16" Value="{ReflectionBinding Badge.Icon}" />
                    <TextBlock x:Name="BadgeText"
                               Text="{ReflectionBinding Badge.Text}"
                               Theme="{StaticResource BodySMNormalTheme}"
                               Foreground="{StaticResource PrimaryStrongBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- read only pill -->
                <StackPanel x:Name="ReadOnlyPillStack"
                            Orientation="Horizontal"
                            Spacing="8">

                    <Ellipse Fill="{StaticResource StrokeTranslucentModerateBrush}" Width="4" Height="4" />

                    <Border
                        ToolTip.Tip="{x:Static resources:Language.CollectionLoadoutView_ReadOnly_ToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <icons:UnifiedIcon Size="16"
                                               Foreground="{StaticResource NeutralTranslucentModerateBrush}"
                                               Value="{x:Static icons:IconValues.Info}" />
                            <TextBlock Text="{x:Static resources:Language.CollectionLoadoutView_ReadOnly}"
                                       Foreground="{StaticResource NeutralTranslucentModerateBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:Statusbar>

            <Border x:Name="DownloadsTreeContainer"
                    Padding="0 8 0 0"
                    Background="{StaticResource SurfaceTransparentBrush}">
                <Panel>
                    <!-- tree data grid -->
                    <TreeDataGrid Grid.Row="2" x:Name="TreeDataGrid"
                                  ShowColumnHeaders="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  Classes="MainListsStyling" >
                        <TreeDataGrid.Styles>
                            <Style Selector="TreeDataGridRow">
                                <Setter Property="ContextFlyout" Value="{StaticResource LoadoutItemMenuFlyout}" />
                            </Style>
                        </TreeDataGrid.Styles>
                    </TreeDataGrid>

                    <!-- shown over the empty table while a search hides every mod -->
                    <TextBlock x:Name="NoMatchesText"
                               Text="{x:Static resources:Language.CollectionLoadoutView_NoModsMatch}"
                               IsVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource NeutralTranslucentModerateBrush}" />
                </Panel>
            </Border>
        </DockPanel>
    </reactive:ReactiveUserControl.Resources>

    <Border>

        <!-- header, tabcontrol -->
        <Grid x:Name="Body" RowDefinitions="Auto, *">

            <!-- the collection's banner, behind the header only so the rest of the page keeps the panel (and Glass) -->
            <Border x:Name="HeaderImageBorder" Grid.Row="0" />

            <!-- first row (header) -->
            <Border x:Name="HeaderBorder" Grid.Row="0">

                <StackPanel x:Name="Header">

                    <!-- first header row (image and metadata) -->
                    <Border x:Name="MainContentBorder">
                        <Grid x:Name="MainContent" ColumnDefinitions="*, Auto, Auto">

                            <!-- left column (image and headings) -->
                            <DockPanel Grid.Column="0" x:Name="CollectionTitles">
                                <Border DockPanel.Dock="Left" x:Name="CollectionImageBorder">
                                    <Image x:Name="CollectionImage" />
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="Title" />
                                    <TextBlock x:Name="CollectionName" />
                                </StackPanel>
                            </DockPanel>

                            <!-- right column (metadata) -->
                            <StackPanel Grid.Column="1" x:Name="CollectionDetails">

                                <StackPanel x:Name="TagsPanel">

                                    <!-- author and avatar -->
                                    <StackPanel x:Name="AuthorStackPanel">
                                        <Border x:Name="AuthorAvatarBorder">
                                            <Image x:Name="AuthorAvatar" />
                                        </Border>
                                        <TextBlock x:Name="AuthorName" />
                                    </StackPanel>

                                    <Ellipse x:Name="VersionSeparator" Fill="{StaticResource NeutralTranslucentWeakBrush}" Width="4" Height="4" />

                                    <!-- revision or version -->
                                    <StackPanel x:Name="RevisionsPanel">
                                        <TextBlock x:Name="Revision" />
                                        <!-- <icons:UnifiedIcon x:Name="ArrowRight" -->
                                        <!--                    Value="{x:Static icons:IconValues.ArrowForward}" -->
                                        <!--                    IsVisible="True" /> -->
                                        <!-- <TextBlock x:Name="NewestRevision" IsVisible="True" /> -->
                                    </StackPanel>

                                </StackPanel>

                                <StackPanel x:Name="StatsPanel">
                                    <StackPanel x:Name="OverallRatingPanel"
                                                ToolTip.Tip="{x:Static resources:Language.CollectionDownloadViewModel_StatsRating_ToolTip}">
                                        <icons:UnifiedIcon x:Name="OverallRatingIcon"
                                                           Value="{x:Static icons:IconValues.CheckCircle}" />
                                        <TextBlock x:Name="OverallRating" />
                                    </StackPanel>

                                    <StackPanel x:Name="EndorsementsPanel"
                                                ToolTip.Tip="{x:Static resources:Language.CollectionDownloadViewModel_StatsEndorsements_ToolTip}">
                                        <icons:UnifiedIcon Value="{x:Static icons:IconValues.ThumbUpOutline}" />
                                        <TextBlock x:Name="Endorsements" />
                                    </StackPanel>
                                    <StackPanel x:Name="DownloadsPanel"
                                                ToolTip.Tip="{x:Static resources:Language.CollectionDownloadViewModel_StatsDownloads_ToolTip}">
                                        <icons:UnifiedIcon Value="{x:Static icons:IconValues.TrayArrowDown}" />
                                        <TextBlock x:Name="TotalDownloads" />
                                    </StackPanel>
                                    <StackPanel x:Name="TotalSizePanel"
                                                ToolTip.Tip="{x:Static resources:Language.CollectionDownloadViewModel_StatsSize_ToolTip}">
                                        <icons:UnifiedIcon Value="{x:Static icons:IconValues.HardDrive}" />
                                        <TextBlock x:Name="TotalSize" />
                                    </StackPanel>
                                    <StackPanel x:Name="ArchivesPanel"
                                                ToolTip.Tip="Archives the list downloads">
                                        <icons:UnifiedIcon Value="{x:Static icons:IconValues.Download}" />
                                        <TextBlock x:Name="ArchiveCountText" />
                                    </StackPanel>
                                    <StackPanel x:Name="ModsPanel"
                                                ToolTip.Tip="{x:Static resources:Language.CollectionDownloadViewModel_StatsMods_ToolTip}">
                                        <icons:UnifiedIcon Value="{x:Static icons:IconValues.ModsOutline}" />
                                        <TextBlock x:Name="NumDownloads" />
                                        <ToggleSwitch x:Name="CollectionToggle" Classes="ExtraSmall"
                                                      ToolTip.Tip="{x:Static resources:Language.CollectionDownloadViewModel_Toggle_ToolTip}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>


                            <!-- Dots menu button: in the header so every tab, and a page without an Installed tab, has it -->
                            <controls:StandardButton x:Name="MoreButton"
                                                     Grid.Column="2"
                                                     VerticalAlignment="Top"
                                                     LeftIcon="{x:Static icons:IconValues.MoreVertical}"
                                                     ShowLabel="False"
                                                     ShowIcon="Left"
                                                     Size="Toolbar"
                                                     ToolTip.Tip="{x:Static resources:Language.CollectionLoadoutView_More_ToolTip}">

                                <controls:StandardButton.Flyout>
                                    <!-- filled from the page's MenuItems -->
                                    <MenuFlyout />
                                </controls:StandardButton.Flyout>
                            </controls:StandardButton>
                        </Grid>
                    </Border>

                    <!-- the collection's description, cut to a few lines until expanded -->
                    <StackPanel x:Name="DescriptionPanel" Margin="0,12,0,0" Spacing="4" IsVisible="False">
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                        <controls:StandardButton x:Name="DescriptionToggle" Type="Tertiary" ShowIcon="None" Size="Toolbar" Text="Show more" HorizontalAlignment="Left" IsVisible="False" />
                    </StackPanel>

                    <!-- an install in flight, shown whichever tab is open -->
                    <StackPanel x:Name="InstallProgressPanel" Margin="0,12,0,0" Spacing="4" IsVisible="False">
                        <TextBlock x:Name="InstallProgressText" />
                        <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="1" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- second row (tab control) -->
            <TabControl x:Name="TabControl" Grid.Row="1">
                <TabItem x:Name="InstalledTab" Content="{StaticResource TabItemContent}">
                    <TabItem.Header>
                        <StackPanel x:Name="InstalledModsPanel" Classes="TabItemHeaderStack">
                            <TextBlock Text="{x:Static resources:Language.CollectionLoadoutView_Installed}" />
                            <Border>
                                <TextBlock x:Name="InstalledModsCountText" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <!-- the collection author's instructions -->
                <TabItem x:Name="InstructionsTab" IsVisible="False">
                    <TabItem.Header>
                        <StackPanel Classes="TabItemHeaderStack">
                            <TextBlock Text="{x:Static resources:Language.CollectionLoadoutView_Instructions}" />
                        </StackPanel>
                    </TabItem.Header>
                    <collectionDownload:CollectionInstructionsView x:Name="InstructionsContent" />
                </TabItem>
                <!-- the collection's download page, with its own Required, Optional and instructions tabs -->
                <TabItem x:Name="DownloadsTab">
                    <TabItem.Header>
                        <StackPanel Classes="TabItemHeaderStack">
                            <TextBlock Text="{x:Static resources:Language.CollectionLoadoutView_Downloads}" />
                        </StackPanel>
                    </TabItem.Header>
                    <reactive:ViewModelViewHost x:Name="DownloadsHost" />
                </TabItem>
            </TabControl>
        </Grid>
    </Border>


</reactive:ReactiveUserControl>
