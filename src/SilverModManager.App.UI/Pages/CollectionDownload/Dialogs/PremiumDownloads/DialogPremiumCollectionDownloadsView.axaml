<reactiveUi:ReactiveUserControl x:TypeArguments="premiumDownloads:DialogPremiumCollectionDownloadsViewModel"
                                xmlns="https://github.com/avaloniaui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                xmlns:reactiveUi="http://reactiveui.net"
                                xmlns:premiumDownloads="clr-namespace:SilverModManager.App.UI.Pages.CollectionDownload.Dialogs.PremiumDownloads"
                                xmlns:controls="clr-namespace:SilverModManager.App.UI.Controls"
                                xmlns:resources="clr-namespace:SilverModManager.App.UI.Resources"
                                mc:Ignorable="d" d:DesignWidth="500"
                                x:Class="SilverModManager.App.UI.Pages.CollectionDownload.Dialogs.PremiumDownloads.DialogPremiumCollectionDownloadsView">

    <StackPanel Spacing="{StaticResource Spacing-4}">
        
        <TextBlock x:Name="MessageTextBlock" 
                   TextWrapping="WrapWithOverflow"
                   Theme="{StaticResource BodySMSemiTheme}"
                   Text="{x:Static resources:Language.UpgradeToPremiumView_Desc1}" />

        <TextBlock x:Name="MessageTextBlock2"
                   TextWrapping="WrapWithOverflow"
                   Text="{x:Static resources:Language.UpgradeToPremiumView_Desc2}" />
    </StackPanel>


</reactiveUi:ReactiveUserControl>
