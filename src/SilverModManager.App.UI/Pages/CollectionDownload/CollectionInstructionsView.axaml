<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reactiveUi="http://reactiveui.net"
    xmlns:collectionDownload="clr-namespace:SilverModManager.App.UI.Pages.CollectionDownload"
    x:Class="SilverModManager.App.UI.Pages.CollectionDownload.CollectionInstructionsView">

    <UserControl.Resources>
        <DataTemplate x:Key="InstructionsTemplate" DataType="collectionDownload:ModInstructions">
            <Border Classes="ModInstructionBorder">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{CompiledBinding ModName, Mode=OneTime}" />
                    <TextBlock Text="{CompiledBinding Instructions, Mode=OneTime}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- the instructions are the whole tab, so the sections are plain headings rather than expanders -->
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Margin="24" Spacing="24">

            <StackPanel x:Name="CollectionInstructionsSection" IsVisible="False" Spacing="8">
                <TextBlock Theme="{StaticResource BodyMDSemiTheme}" Text="Collection Instructions" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1024" />
                    </Grid.ColumnDefinitions>
                    <reactiveUi:ViewModelViewHost x:Name="CollectionInstructionsRendererHost" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="RequiredModsInstructionsSection" IsVisible="False" Spacing="8">
                <TextBlock Theme="{StaticResource BodyMDSemiTheme}" Text="Mod Instructions" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1024" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="RequiredModsInstructions"
                                  ItemTemplate="{StaticResource InstructionsTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="OptionalModsInstructionsSection" IsVisible="False" Spacing="8">
                <TextBlock Theme="{StaticResource BodyMDSemiTheme}" Text="Optional Mod Instructions" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1024" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="OptionalModsInstructions"
                                  ItemTemplate="{StaticResource InstructionsTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
