<reactiveUi:ReactiveUserControl x:TypeArguments="update:ICollectionUpdateProgressViewModel"
                                xmlns="https://github.com/avaloniaui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                xmlns:reactiveUi="http://reactiveui.net"
                                xmlns:update="clr-namespace:SilverModManager.App.UI.Pages.Collections.Update"
                                mc:Ignorable="d" d:DesignWidth="320"
                                x:Class="SilverModManager.App.UI.Pages.Collections.Update.CollectionUpdateProgressView">

    <TextBlock x:Name="ProgressText" TextWrapping="WrapWithOverflow" />

</reactiveUi:ReactiveUserControl>
