<reactive:ReactiveUserControl
    x:TypeArguments="local:IToolsPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactive="http://reactiveui.net"
    xmlns:local="clr-namespace:SilverModManager.App.UI.Pages.Tools"
    xmlns:controls="clr-namespace:SilverModManager.App.UI.Controls"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
    x:Class="SilverModManager.App.UI.Pages.Tools.ToolsPageView">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="{StaticResource Spacing-4}" MaxWidth="800" HorizontalAlignment="Left">

            <TextBlock Text="Tools" Theme="{StaticResource HeadingSMSemiTheme}" />
            <StackPanel x:Name="ToolsPanel" Spacing="{StaticResource Spacing-2}" />

            <Separator />

            <TextBlock Text="Your programs" Theme="{StaticResource HeadingSMSemiTheme}" />
            <StackPanel x:Name="UserToolsPanel" Spacing="{StaticResource Spacing-2}" />
            <TextBox x:Name="UserToolNameBox" Watermark="Name" />
            <DockPanel>
                <controls:StandardButton x:Name="BrowseUserToolButton"
                                         DockPanel.Dock="Right"
                                         Type="Secondary"
                                         Size="Toolbar"
                                         Text="Browse..." />
                <TextBox x:Name="UserToolExeBox" Watermark="Absolute path to the program" />
            </DockPanel>
            <TextBox x:Name="UserToolArgumentsBox" Watermark="Arguments" />
            <ComboBox x:Name="UserToolRunViaBox" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing-2}">
                <controls:StandardButton x:Name="SaveUserToolButton"
                                         Type="Primary"
                                         Size="Toolbar"
                                         Fill="StrongAlt"
                                         Text="Add program" />
                <controls:StandardButton x:Name="CancelUserToolEditButton"
                                         Type="Secondary"
                                         Size="Toolbar"
                                         Text="Cancel" />
            </StackPanel>

            <Separator />

            <TextBlock Text="Run a Windows program in this game's prefix"
                       Theme="{StaticResource HeadingSMSemiTheme}" />
            <TextBlock x:Name="PrefixText" TextWrapping="Wrap" />
            <TextBlock x:Name="StrategyText" TextWrapping="Wrap" />
            <TextBlock x:Name="DiagnosticText" TextWrapping="Wrap" />
            <controls:StandardButton x:Name="RunWindowsProgramButton"
                                     Type="Primary"
                                     Size="Toolbar"
                                     Fill="StrongAlt"
                                     Text="Choose a program..."
                                     HorizontalAlignment="Left" />
            <TextBlock x:Name="LastRunText" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>

</reactive:ReactiveUserControl>
