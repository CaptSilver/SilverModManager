<reactive:ReactiveUserControl
    x:TypeArguments="local:ICatalogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactive="http://reactiveui.net"
    xmlns:local="clr-namespace:SilverModManager.App.UI.Pages.Catalog"
    xmlns:cards="clr-namespace:SilverModManager.App.UI.Controls.Cards"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
    x:Class="SilverModManager.App.UI.Pages.Catalog.CatalogView">

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource Spacing-4}" Margin="0 0 0 16">
            <TextBlock x:Name="TitleText" Theme="{StaticResource HeadingSMSemiTheme}" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing-2}">
                <TextBox x:Name="SearchBox" Width="320" Watermark="Search mods or authors" />
                <cards:StoreSortBox x:Name="SortBox" />
            </StackPanel>
        </StackPanel>

        <cards:CardGrid x:Name="CardList" EndReached="OnEndReached">
            <cards:CardGrid.CardTemplate>
                <DataTemplate x:DataType="local:CatalogCardRow">
                    <Border Classes="GridCard" Height="470">
                        <DockPanel LastChildFill="True">
                            <!-- Stacked: side by side the two buttons are wider than the card. -->
                            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0 8 0 0">
                                <Button Content="{Binding InstallLabel}" Click="OnInstallClick" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                                <Button Content="Open website" Click="OnOpenClick" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <!-- Clipped so a card with every line at its longest cuts the text off rather than drawing it under the buttons. -->
                            <StackPanel Spacing="4" ClipToBounds="True">
                                <cards:CardThumbnail Width="214" Height="214" Stretch="UniformToFill"
                                                     RenderOptions.BitmapInterpolationMode="HighQuality"
                                                     ImageUrl="{Binding Icon}" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding OwnerLine}" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding OwnerLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Summary}"
                                           IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </cards:CardGrid.CardTemplate>
        </cards:CardGrid>
    </DockPanel>

</reactive:ReactiveUserControl>
