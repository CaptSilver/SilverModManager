<reactiveUi:ReactiveUserControl x:TypeArguments="applyDiff:IApplyDiffViewModel" xmlns="https://github.com/avaloniaui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                xmlns:reactiveUi="http://reactiveui.net"
                                xmlns:applyDiff="clr-namespace:SilverModManager.App.UI.Pages.Diff.ApplyDiff"
                                xmlns:trees="clr-namespace:SilverModManager.App.UI.Controls.Trees"
                                xmlns:icons="clr-namespace:SilverModManager.UI.Sdk.Icons;assembly=SilverModManager.UI.Sdk"
                                xmlns:resources="clr-namespace:SilverModManager.App.UI.Resources"
                                xmlns:controls="clr-namespace:SilverModManager.App.UI.Controls"
                                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                                x:Class="SilverModManager.App.UI.Pages.Diff.ApplyDiff.ApplyDiffView">
    <Design.DataContext>
        <applyDiff:ApplyDiffDesignViewModel />
    </Design.DataContext>

    <Grid x:Name="RootGrid" RowDefinitions="Auto, *">
        <Grid.KeyBindings>
            <KeyBinding Gesture="Delete" />
        </Grid.KeyBindings>

        <Border Classes="Toolbar" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:StandardButton x:Name="RefreshButton"
                                         LeftIcon="{x:Static icons:IconValues.Refresh}"
                                         Text="Refresh"
                                         ShowIcon="Left"
                                         Size="Small"
                                         Fill="WeakAlt" />
                <controls:StandardButton x:Name="RemoveButton"
                                         LeftIcon="{x:Static icons:IconValues.DeleteForever}"
                                         Text="Delete"
                                         ShowIcon="Left"
                                         Size="Small"
                                         Fill="WeakAlt" />
            </StackPanel>
        </Border>

        <reactiveUi:ViewModelViewHost Grid.Row="1" x:Name="TreeViewHost">
            <reactiveUi:ViewModelViewHost.ContextFlyout>
                <MenuFlyout>
                    <MenuItem x:Name="MenuItemRemove" Classes="Critical" Header="Delete">
                        <MenuItem.Icon>
                            <icons:UnifiedIcon Value="{x:Static icons:IconValues.DeleteForever}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuFlyout>
            </reactiveUi:ViewModelViewHost.ContextFlyout>
        </reactiveUi:ViewModelViewHost>
        <TextBlock Grid.Row="1" x:Name="FailedText"
                   Text="{x:Static resources:Language.ApplyDiff_LoadFailed}"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   Margin="16" />
    </Grid>
</reactiveUi:ReactiveUserControl>
