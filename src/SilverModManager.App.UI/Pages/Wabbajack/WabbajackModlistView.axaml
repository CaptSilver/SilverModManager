<reactive:ReactiveUserControl
    x:TypeArguments="local:IWabbajackModlistViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactive="http://reactiveui.net"
    xmlns:local="clr-namespace:SilverModManager.App.UI.Pages.Wabbajack"
    xmlns:controls="clr-namespace:SilverModManager.App.UI.Controls"
    xmlns:icons="clr-namespace:SilverModManager.UI.Sdk.Icons;assembly=SilverModManager.UI.Sdk"
    mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
    x:Class="SilverModManager.App.UI.Pages.Wabbajack.WabbajackModlistView">

    <Design.DataContext>
        <local:WabbajackModlistDesignViewModel />
    </Design.DataContext>

    <reactive:ReactiveUserControl.Styles>
        <Style Selector="TextBlock#StatusText.Warning">
            <Setter Property="Foreground" Value="{DynamicResource DangerStrongBrush}" />
        </Style>
    </reactive:ReactiveUserControl.Styles>

    <reactive:ReactiveUserControl.Resources>
        <MenuFlyout x:Key="ModlistMenuFlyout">
            <MenuItem x:Name="MenuCheckInbox" Header="Check inbox" />
            <MenuItem x:Name="MenuOpenInboxFolder" Header="Open inbox folder" />
            <MenuItem x:Name="MenuChooseDownloadsFolder" Header="Choose download folder..." />
            <MenuItem x:Name="MenuDefaultDownloadsFolder" Header="Use the default download folder" />
            <MenuItem x:Name="MenuOpenReadme" Header="Open readme" IsVisible="False" />
            <MenuItem x:Name="MenuRemove" Header="Remove modlist" Classes="Critical" IsVisible="False" />
        </MenuFlyout>
    </reactive:ReactiveUserControl.Resources>

    <!-- header, toolbar, the one status line, then the archives. Styled by the Collections page's header rules. -->
    <Grid x:Name="Body" RowDefinitions="Auto, Auto, Auto, *">

        <Border x:Name="HeaderImageBorder" Grid.Row="0" />

        <Border x:Name="HeaderBorder" Grid.Row="0">
            <StackPanel x:Name="Header">
                <Border x:Name="MainContentBorder">
                    <Grid x:Name="MainContent" ColumnDefinitions="*, Auto">

                        <DockPanel Grid.Column="0" x:Name="CollectionTitles">
                            <Border DockPanel.Dock="Left" x:Name="CollectionImageBorder">
                                <Image x:Name="CollectionImage" />
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="Title" Text="Wabbajack modlist" />
                                <TextBlock x:Name="CollectionName" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Column="1" x:Name="CollectionDetails">
                            <StackPanel x:Name="TagsPanel">
                                <StackPanel x:Name="AuthorStackPanel">
                                    <TextBlock x:Name="AuthorName" />
                                </StackPanel>
                                <Ellipse Fill="{StaticResource NeutralTranslucentWeakBrush}" Width="4" Height="4" />
                                <TextBlock x:Name="GameText" Classes="Tag" />
                                <Ellipse Fill="{StaticResource NeutralTranslucentWeakBrush}" Width="4" Height="4" />
                                <TextBlock x:Name="VersionText" Classes="Tag" />
                            </StackPanel>

                            <StackPanel x:Name="StatsPanel">
                                <StackPanel>
                                    <icons:UnifiedIcon Value="{x:Static icons:IconValues.ModsOutline}" />
                                    <TextBlock x:Name="ArchiveCount" />
                                </StackPanel>
                                <StackPanel ToolTip.Tip="Download size of every archive">
                                    <icons:UnifiedIcon Value="{x:Static icons:IconValues.HardDrive}" />
                                    <TextBlock x:Name="ArchiveSize" />
                                </StackPanel>
                                <StackPanel x:Name="FreeSpacePanel" ToolTip.Tip="Extracted size, next to the free space where archives are kept">
                                    <icons:UnifiedIcon Value="{x:Static icons:IconValues.HardDrive}" />
                                    <TextBlock x:Name="FreeSpace" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="DescriptionPanel" Margin="0,12,0,0" Spacing="4" IsVisible="False">
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                    <controls:StandardButton x:Name="DescriptionToggle" Type="Tertiary" ShowIcon="None" Size="Toolbar" Text="Show more" HorizontalAlignment="Left" IsVisible="False" />
                </StackPanel>
            </StackPanel>
        </Border>

        <controls:Statusbar x:Name="Toolbar" Grid.Row="1">
            <controls:StandardButton Flyout="{StaticResource ModlistMenuFlyout}"
                                     ShowLabel="False"
                                     LeftIcon="{x:Static icons:IconValues.MoreVertical}"
                                     ShowIcon="Left"
                                     Size="Toolbar" />
            <controls:StandardButton x:Name="DownloadButton" Type="Secondary" Fill="Strong" Size="Toolbar" Text="Download" />
            <controls:StandardButton x:Name="InstallButton" Type="Primary" Fill="Strong" Size="Toolbar" Text="Install collection" />
            <controls:StandardButton x:Name="ResumeButton" Type="Primary" Fill="Strong" Size="Toolbar" Text="Resume" />
            <TextBlock Text="into" VerticalAlignment="Center" />
            <ComboBox x:Name="LoadoutBox" MaxHeight="24" MinWidth="220" PlaceholderText="Pick a loadout…" ToolTip.Tip="The modlist is added to this loadout as a collection, like a Nexus collection. Pick &quot;Create new loadout&quot; to keep it apart from your other mods." />
            <CheckBox x:Name="SkipBox" Content="Skip files from missing archives" VerticalAlignment="Center" />
            <CheckBox x:Name="PickUpBox" Content="Pick up finished downloads from your Downloads folder" VerticalAlignment="Center" IsVisible="False" />
            <Separator />
            <controls:StandardButton x:Name="OpenNextFiveButton" Type="Secondary" Fill="Weak" Size="Toolbar" Text="Open next five" />
        </controls:Statusbar>

        <StackPanel x:Name="StatusPanel" Grid.Row="2" Margin="24,8" Spacing="4">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <controls:StandardButton x:Name="ShowThemButton" Type="Tertiary" ShowIcon="None" Size="Toolbar" Text="Show them" HorizontalAlignment="Left" IsVisible="False"
                                     ToolTip.Tip="Jump to the archives you have to get yourself, or list what is missing" />
            <ProgressBar x:Name="StatusBar" Minimum="0" Maximum="1" HorizontalAlignment="Left" MinWidth="280" IsVisible="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="3">
            <StackPanel x:Name="Content" Margin="24,0,24,24" Spacing="{StaticResource Spacing-4}">
                <!-- The few archives the user has to fetch, so they are not hunted for in a table of over a thousand. -->
                <StackPanel x:Name="NeedsYouPanel" Spacing="2" IsVisible="False">
                    <DockPanel>
                        <controls:StandardButton x:Name="CopyListButton" DockPanel.Dock="Right" Type="Secondary" Fill="Weak" Size="Toolbar" Text="Copy list"
                                                 ToolTip.Tip="Copy the file names and pages of these archives to the clipboard" />
                        <TextBlock x:Name="NeedsYouHeading" Theme="{StaticResource HeadingSMSemiTheme}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Get these yourself, then drop the files anywhere on this page." Opacity="0.7" />
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NeedsYouRows">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="ArchivesPanel" Spacing="2">
                    <DockPanel>
                        <ComboBox x:Name="ArchiveFilterBox" DockPanel.Dock="Right" MinWidth="140" SelectedIndex="0" ToolTip.Tip="Which archives the list shows">
                            <ComboBoxItem Content="All" />
                            <ComboBoxItem Content="Needs you" />
                            <ComboBoxItem Content="Missing" />
                            <ComboBoxItem Content="In library" />
                        </ComboBox>
                        <TextBlock Text="Archives" Theme="{StaticResource HeadingSMSemiTheme}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Drop downloaded archives anywhere on this page to add them to the inbox." Opacity="0.7" />
                    <TextBlock x:Name="InboxText" TextWrapping="Wrap" />
                    <!-- Lists can hold well over a thousand archives; only the lines in view are built. -->
                    <ItemsControl x:Name="ArchiveRows">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="GameFilesPanel" Spacing="2">
                    <TextBlock Text="Game files this list replaces" Theme="{StaticResource HeadingSMSemiTheme}" />
                    <TextBlock Text="Tick a file to keep the copy in the game folder." Opacity="0.7" />
                    <ItemsControl x:Name="GameFileRows">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="SkippedPanel" Spacing="2">
                    <TextBlock Text="Files that were skipped" Theme="{StaticResource HeadingSMSemiTheme}" />
                    <controls:StandardButton x:Name="HealthCheckButton" Type="Secondary" Size="Toolbar" Text="Open Health Check" HorizontalAlignment="Left" />
                    <ItemsControl x:Name="SkippedRows">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</reactive:ReactiveUserControl>
