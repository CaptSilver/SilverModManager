<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!--
    The NuGet package was built in Release, where Debug.Assert and #if DEBUG code compile out.
    The app's own code retracts datoms that were never asserted, which the library tolerates
    but its debug assertions reject, so the vendored library keeps the package's behaviour in
    every configuration. DEBUG is added by the SDK after this file is read, hence the target.
    -->
    <Target Name="DropDebugConstantFromVendoredLibrary" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <DefineConstants>$(DefineConstants.Replace('DEBUG;', '').Replace(';DEBUG', ''))</DefineConstants>
        </PropertyGroup>
    </Target>
</Project>
