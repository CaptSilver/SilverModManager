<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\SmmNativeRid.props" />

    <PropertyGroup>
        <!-- Without this the SDK treats a plain library as RID-agnostic and builds it without the app's -r, so SmmNativeRid would fall back to the build machine. -->
        <IsRidAgnostic>false</IsRidAgnostic>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SilverModManager.Abstractions.Games.Diagnostics\SilverModManager.Abstractions.Games.Diagnostics.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.Games.Merge\SilverModManager.Abstractions.Games.Merge.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.Games\SilverModManager.Abstractions.Games.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.Secrets\SilverModManager.Abstractions.Secrets.csproj" />
        <ProjectReference Include="..\SilverModManager.Games.FileHashes\SilverModManager.Games.FileHashes.csproj" />
        <ProjectReference Include="..\SilverModManager.Games.Generic\SilverModManager.Games.Generic.csproj" />
        <ProjectReference Include="..\SilverModManager.Platform.Proton\SilverModManager.Platform.Proton.csproj" />
        <ProjectReference Include="..\SilverModManager.Sdk\SilverModManager.Sdk.csproj" />
        <ProjectReference Include="..\SilverModManager.App.Generators.Diagnostics\SilverModManager.App.Generators.Diagnostics.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SilverModManager.MnemonicDB.SourceGenerator\SilverModManager.MnemonicDB.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <PackageReference Include="Tomlyn" />
        <PackageReference Include="ZstdSharp.Port" />
    </ItemGroup>

    <ItemGroup>
        <!-- Built from extern/ooz by scripts/build-ooz.sh; see Formats/Native/LibOozResolver.cs for the lookup. -->
        <None Include="runtimes\$(SmmNativeRid)\native\libooz.so">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath>runtimes/$(SmmNativeRid)/native</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SilverModManager.Games.FromSoft.Tests" />
        <InternalsVisibleTo Include="SilverModManager.UI.Tests" />
    </ItemGroup>
</Project>
