<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <!-- See https://www.freedesktop.org/software/appstream/docs/chap-Metadata.html#spec-component-filespec -->

    <id>io.github.CaptSilver.SilverModManager</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-only</project_license>

    <name>SilverModManager</name>
    <summary>Mod Manager for your games</summary>

    <developer id="io.github.CaptSilver">
        <name>CaptSilver</name>
    </developer>

    <description>
        <p>SilverModManager is a Linux mod manager for your games. It is a fork of the Nexus Mods App and downloads mods from Nexus Mods. It is not affiliated with or endorsed by Nexus Mods.</p>
    </description>

    <branding>
        <color type="primary" scheme_preference="light">#fafafa</color>
        <color type="primary" scheme_preference="dark">#1d1d21</color>
    </branding>

    <launchable type="desktop-id">io.github.CaptSilver.SilverModManager.desktop</launchable>

    <url type="homepage">https://github.com/CaptSilver/SilverModManager</url>
    <url type="bugtracker">https://github.com/CaptSilver/SilverModManager/issues</url>
    <url type="vcs-browser">https://github.com/CaptSilver/SilverModManager</url>

    <content_rating type="oars-1.0">
        <content_attribute id="social-info">intense</content_attribute>
    </content_rating>

    <categories>
        <category>Game</category>
    </categories>

    <recommends>
        <memory>1024</memory>

        <internet>always</internet>
        <display_length compare="ge">360</display_length>

        <id version="1.0" compare="ge">com.valvesoftware.Steam</id>
    </recommends>

    <supports>
        <id version="1.0" compare="ge">com.heroicgameslauncher.hgl</id>

        <control>gamepad</control>
    </supports>

    <!-- NOTE(erri120): we use a script to turn GitHub releases into a supported format -->
    <releases type="external"/>

</component>
