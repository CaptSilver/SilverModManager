<Project Sdk="Microsoft.NET.Sdk">
    <!-- NuGet Package Shared Details -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('NuGet.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    
    <ItemGroup>
      <ProjectReference Include="..\SilverModManager.MnemonicDB\SilverModManager.MnemonicDB.csproj" />
      <ProjectReference Include="..\SilverModManager.MnemonicDB.SourceGenerator\SilverModManager.MnemonicDB.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
      <PackageReference Include="NexusMods.Paths" />
      <PackageReference Include="YamlDotNet" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="SilverModManager.Games.FileHashes.Tests" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SilverModManager.Abstractions.Steam\SilverModManager.Abstractions.Steam.csproj" />
      <ProjectReference Include="..\SilverModManager.Abstractions.Cli\SilverModManager.Abstractions.Cli.csproj" />
      <ProjectReference Include="..\SilverModManager.Abstractions.Games.Diagnostics\SilverModManager.Abstractions.Games.Diagnostics.csproj" />
      <ProjectReference Include="..\SilverModManager.Abstractions.Games.FileHashes\SilverModManager.Abstractions.Games.FileHashes.csproj" />
      <ProjectReference Include="..\SilverModManager.Abstractions.Games\SilverModManager.Abstractions.Games.csproj" />
      <ProjectReference Include="..\SilverModManager.App.Generators.Diagnostics\SilverModManager.App.Generators.Diagnostics.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"  />
      <ProjectReference Include="..\SilverModManager.Networking.EpicGameStore\SilverModManager.Networking.EpicGameStore.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <HashesDatabaseInput>https://github.com/CaptSilver/game-hashes/releases/latest/download/game_hashes_db.zip</HashesDatabaseInput>
        <HashesDatabaseOutput>$(BaseIntermediateOutputPath)games_hashes_db.zip</HashesDatabaseOutput>
    </PropertyGroup>

    <!-- NOTE(erri120): Downloading the games hashes database at build time if it doesn't exist -->
    <Target Name="DownloadHashesDatabase" BeforeTargets="BeforeBuild" Condition="!Exists('$(HashesDatabaseOutput)')">
        <MakeDir Directories="$(BaseIntermediateOutputPath)" />
        <Exec Condition="'$(OS)' != 'Windows_NT'" Command="curl -fsSL -o $(HashesDatabaseOutput) $(HashesDatabaseInput)"  />
        <Exec Condition="'$(OS)' == 'Windows_NT'" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Invoke-WebRequest -Uri '$(HashesDatabaseInput)' -OutFile '$(HashesDatabaseOutput)'&quot;" />
    </Target>

    <Target Name="EmbedOutput" AfterTargets="DownloadHashesDatabase">
        <Error Condition="!Exists('$(HashesDatabaseOutput)')" Text="Failed to embed file $(HashesDatabaseOutput)" />

        <ItemGroup>
            <EmbeddedResource Include="$(HashesDatabaseOutput)" LogicalName="games_hashes_db.zip" />
        </ItemGroup>
    </Target>
    
    <ItemGroup>
        <AdditionalFiles Include="**\*.sql" />
        <UpToDateCheckInput Include="**\*.sql"/>
    </ItemGroup>
</Project>
