<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_UseSystemExtractor Condition="$([System.String]::new('$(DefineConstants)').Contains('SMM_USE_SYSTEM_EXTRACTOR'))">true</_UseSystemExtractor>
  </PropertyGroup>

  <PropertyGroup Condition="$(UseSystemExtractor) == 'true'">
    <DefineConstants>$(DefineConstants);SMM_USE_SYSTEM_EXTRACTOR</DefineConstants>
    <_UseSystemExtractor>true</_UseSystemExtractor>
  </PropertyGroup>
    
  <ItemGroup Condition="'$(_UseSystemExtractor)' == '' Or '$(_UseSystemExtractor)' == 'false'">
    <!-- The bundled binaries for the build's runtime identifier (SmmNativeRid), whatever PlatformTarget says. -->
    <None Include="$(MSBuildThisFileDirectory)../runtimes/$(SmmNativeRid)/**" Exclude="$(MSBuildThisFileDirectory)*.targets">
      <Link>runtimes\$(SmmNativeRid)\native\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>False</Visible>
    </None>
  </ItemGroup>
</Project>
