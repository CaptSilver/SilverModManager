<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\SmmNativeRid.props" />

    <PropertyGroup>
        <!-- Without this the SDK treats a plain library as RID-agnostic and builds it without the app's -r, so SmmNativeRid would fall back to the build machine. -->
        <IsRidAgnostic>false</IsRidAgnostic>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SilverModManager.Abstractions.Games.FileHashes\SilverModManager.Abstractions.Games.FileHashes.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.Games\SilverModManager.Abstractions.Games.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.Cli\SilverModManager.Abstractions.Cli.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.Loadouts.Synchronizers\SilverModManager.Abstractions.Loadouts.Synchronizers.csproj" />
        <ProjectReference Include="..\SilverModManager.Sdk\SilverModManager.Sdk.csproj" />
        <ProjectReference Include="..\SilverModManager.UI.Sdk\SilverModManager.UI.Sdk.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.HighPerformance"/>
        <PackageReference Include="GameFinder.Launcher.Heroic" />
        <PackageReference Include="GameFinder.RegistryUtils" />
        <PackageReference Include="GameFinder.StoreHandlers.EGS" />
        <PackageReference Include="GameFinder.StoreHandlers.GOG" />
        <PackageReference Include="GameFinder.StoreHandlers.Steam" />
        <PackageReference Include="GameFinder.Wine" />
        <PackageReference Include="LinuxDesktopUtils.XDGDesktopPortal" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="TransparentValueObjects" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\SilverModManager.MnemonicDB.SourceGenerator\SilverModManager.MnemonicDB.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <PackageReference Include="System.Linq.Async" />
        <PackageReference Include="YamlDotNet" />
    </ItemGroup>
    
    <ItemGroup>
        <EmbeddedResource Include="../SilverModManager.App/io.github.CaptSilver.SilverModManager.desktop" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SilverModManager.Backend.Tests"/>
        <InternalsVisibleTo Include="SilverModManager.CLI.Tests"/>
        <InternalsVisibleTo Include="SilverModManager.CrossPlatform.Tests"/>
        <InternalsVisibleTo Include="SilverModManager.Games.TestFramework"/>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="OS\LinuxInterop.Protocol.cs">
        <DependentUpon>LinuxInterop.cs</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
        <!-- Using .nupkg convention for auto extract. -->
        <None Update="runtimes\$(SmmNativeRid)\**">
            <Pack>true</Pack>
            <PackagePath>runtimes/$(SmmNativeRid)</PackagePath>
        </None>

        <None Update="build\SilverModManager.FileExtractor.targets">
            <Pack>true</Pack>
            <PackagePath>build\SilverModManager.FileExtractor.targets</PackagePath>
        </None>
    </ItemGroup>

    <!-- Non-NuGet Only -->
    <Import Project="build\SilverModManager.FileExtractor.targets" />
</Project>
