<Project Sdk="Microsoft.NET.Sdk">
    <!-- NuGet Package Shared Details -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('NuGet.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
        <PackageReference Include="StrawberryShake.Server" />
    </ItemGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="SilverModManager.Networking.NexusWebApi.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SilverModManager.Abstractions.Cli\SilverModManager.Abstractions.Cli.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.Collections\SilverModManager.Abstractions.Collections.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.NexusModsLibrary\SilverModManager.Abstractions.NexusModsLibrary.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.NexusWebApi\SilverModManager.Abstractions.NexusWebApi.csproj" />
        <ProjectReference Include="..\SilverModManager.Abstractions.Secrets\SilverModManager.Abstractions.Secrets.csproj" />
        <ProjectReference Include="..\SilverModManager.MnemonicDB.SourceGenerator\SilverModManager.MnemonicDB.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\SilverModManager.Networking.HttpDownloader\SilverModManager.Networking.HttpDownloader.csproj" />
        <ProjectReference Include="..\SilverModManager.Networking.ModUpdates\SilverModManager.Networking.ModUpdates.csproj" />
    </ItemGroup>

    <!-- games.json is vendored (only id and domain_name). Refresh it with scripts/update-games-json.sh;
         the build never downloads it. -->
    <ItemGroup>
        <EmbeddedResource Include="V1Interop\games.json" LogicalName="games.json" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="V1Interop\GameMetadata.cs">
        <DependentUpon>LocalMappingCache.cs</DependentUpon>
      </Compile>
      <Compile Update="Errors\GraphQlResult.cs">
        <DependentUpon>IGraphQlResult.cs</DependentUpon>
      </Compile>
      <Compile Update="Errors\NotFound.cs">
        <DependentUpon>IGraphQlError.cs</DependentUpon>
      </Compile>
      <Compile Update="Errors\CollectionDiscarded.cs">
        <DependentUpon>IGraphQlError.cs</DependentUpon>
      </Compile>
      <Compile Update="Errors\CollectionRevisionDiscarded.cs">
        <DependentUpon>IGraphQlError.cs</DependentUpon>
      </Compile>
      <Compile Update="Errors\UnknownError.cs">
        <DependentUpon>IGraphQlError.cs</DependentUpon>
      </Compile>
      <Compile Update="Errors\Invalid.cs">
        <DependentUpon>IGraphQlError.cs</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
