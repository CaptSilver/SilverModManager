<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!--
     The batch file is only used for running redmod through Wine on Linux, so the
     working directory and arguments reach redMod.exe the same way under every runner.
     It is embedded on every build.
    -->

    <PropertyGroup>
        <BatFileName>deploy_redmod.bat</BatFileName>
        <BatFileSourcePath>$(MSBuildThisFileDirectory)..\Resources\Cyberpunk2077\$(BatFileName)</BatFileSourcePath>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(BatFileSourcePath)">
            <LogicalName>$(BatFileName)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
</Project>
